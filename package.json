{
  "name": "longshot",
  "version": "0.1.0",
  "description": "LONGSHOT — launch tokens on Long.xyz by tagging @longdotxyz on X",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "simulate": "tsx src/cli/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@whetstone-research/doppler-sdk": "^1.0.43",
    "hono": "^4.13.8",
    "twitter-api-v2": "^1.29.1",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
