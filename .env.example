# ── General ─────────────────────────────────────────────
PUBLIC_URL=http://localhost:8787
PORT=8787
DB_PATH=data/longshot.db
SESSION_SECRET=change-me-to-a-long-random-string

# ── X (Twitter) ─────────────────────────────────────────
X_ENABLED=false
TRIGGER_HANDLE=longdotxyz
# Recent search (needs an X API plan with search access)
X_BEARER_TOKEN=
# Bot account that posts replies (OAuth 1.0a user context)
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# "Login with X" on /claim (OAuth 2.0 client, callback: $PUBLIC_URL/auth/x/callback)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_POLL_INTERVAL_MS=30000

# ── Anti-spam ───────────────────────────────────────────
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWERS=50
LAUNCHES_PER_DAY=1
TICKER_COOLDOWN_HOURS=24

# ── Chain ───────────────────────────────────────────────
# mock = fake Long.xyz for local dev; onchain = real transactions from the Treasury wallet
CHAIN_MODE=mock
RPC_URL=
CHAIN_ID=
EXPLORER_URL=
# LONGSHOT Treasury hot wallet. Keep the balance small; sweep to cold storage.
TREASURY_PRIVATE_KEY=
LONG_FACTORY_ADDRESS=
LONG_APP_URL=https://app.longxyz.com
DEFAULT_STOCK=NVDA
STOCK_TOKEN_NVDA=
STOCK_TOKEN_AAPL=
STOCK_TOKEN_MSFT=
STOCK_TOKEN_GOOGL=
STOCK_TOKEN_TSLA=
STOCK_TOKEN_MU=
STOCK_TOKEN_SPCX=
HARVEST_INTERVAL_MS=900000
# Max base units paid per claim transaction (0 = no cap)
MAX_PAYOUT_PER_CLAIM=0

# Optional: pin token metadata to IPFS
PINATA_JWT=
