# ── General ─────────────────────────────────────────────
# Public address of the website (production: https://longshotpad.xyz)
PUBLIC_URL=http://localhost:8787
PORT=8787
DB_PATH=data/longshot.db
SESSION_SECRET=change-me-to-a-long-random-string

# ── X (Twitter) ─────────────────────────────────────────
X_ENABLED=false
TRIGGER_HANDLE=longdotxyz
# LONGSHOT's own X account (posts replies; shown on the website)
BOT_HANDLE=longshotpadxyz
# Recent search (needs an X API plan with search access)
X_BEARER_TOKEN=
# Bot account that posts replies (OAuth 1.0a user context)
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# "Login with X" on /claim (OAuth 2.0 client, callback: $PUBLIC_URL/auth/x/callback)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_POLL_INTERVAL_MS=30000

# ── Anti-spam ───────────────────────────────────────────
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWERS=50
LAUNCHES_PER_DAY=1
# A ticker launched (via LONGSHOT or on app.long.xyz) is reserved for N hours. 0 = forever (default, matches app.long.xyz).
TICKER_COOLDOWN_HOURS=0

# ── Chain (Robinhood Chain, via Doppler — the protocol Long.xyz runs on) ──
# mock = fake launchpad for local dev; onchain = real transactions from the Treasury wallet
CHAIN_MODE=mock
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com
# LONGSHOT Treasury hot wallet. Keep the balance small; sweep to cold storage.
TREASURY_PRIVATE_KEY=
LONG_APP_URL=https://app.long.xyz
DEFAULT_STOCK=NVDA
# Pool swap fee in hundredths of a bip (10000 = 1%)
POOL_FEE=10000
# Doppler protocol owner's share of pool fees (min 500 = 5%); the rest goes to the Treasury
PROTOCOL_SHARE_BPS=500
# Stock Token addresses default to the verified list in src/config.ts; override only if needed
# STOCK_TOKEN_NVDA=0x...
HARVEST_INTERVAL_MS=900000
# Long.xyz launcher, scanned for LaunchCreated to know which tickers are taken
LONG_LAUNCHER_ADDRESS=0x22e99278308B393ea1260859B181AD7E78f5eeED
LONG_START_BLOCK=8636038
TICKER_SYNC_INTERVAL_MS=60000
# Max base units paid per asset per claim transaction (0 = no cap)
MAX_PAYOUT_PER_CLAIM=0

# Optional: pin token metadata to IPFS
PINATA_JWT=
