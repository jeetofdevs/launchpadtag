# ── General ─────────────────────────────────────────────
# Public address of the website (production: https://longshotpad.xyz)
PUBLIC_URL=http://localhost:8787
PORT=8787
DB_PATH=data/longshot.db
SESSION_SECRET=change-me-to-a-long-random-string

# ── X (Twitter) ─────────────────────────────────────────
X_ENABLED=false
TRIGGER_HANDLE=longshotpadxyz
# LONGSHOT's own X account (posts replies; shown on the website)
BOT_HANDLE=longshotpadxyz
# Recent search (needs an X API plan with search access)
X_BEARER_TOKEN=
# Bot account that posts replies (OAuth 1.0a user context)
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# "Login with X" on /claim (OAuth 2.0 client, callback: $PUBLIC_URL/auth/x/callback)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_POLL_INTERVAL_MS=30000

# ── Anti-spam ───────────────────────────────────────────
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWERS=50
LAUNCHES_PER_DAY=1
# A ticker launched (via LONGSHOT or on app.long.xyz) is reserved for N hours. 0 = forever (default, matches app.long.xyz).
TICKER_COOLDOWN_HOURS=72

# ── Chain (Robinhood Chain, via Doppler — the protocol Long.xyz runs on) ──
# mock = fake launchpad for local dev; onchain = real transactions from the Treasury wallet
CHAIN_MODE=mock
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com
# LONGSHOT Treasury hot wallet. Keep the balance small; sweep to cold storage.
TREASURY_PRIVATE_KEY=
LONG_APP_URL=https://app.long.xyz
DEFAULT_STOCK=NVDA
# Markets offered on app.long.xyz ("Pick your pairing asset"). Comma separated. Empty = built-in list.
PAIR_MARKETS=
# Extra ERC-20 markets not in the built-in catalogue, e.g. Long.xyz tokens: SYMBOL=0xAddress[=Name], comma separated
EXTRA_MARKETS=
# Pool swap fee in hundredths of a bip (10000 = 1%)
POOL_FEE=10000
# Doppler protocol's share of the pool fee (500..2000 = 5%..20%). Paid out of LONGSHOT's 20%; the deployer always gets 80%.
PROTOCOL_SHARE_BPS=500
# Stock Token addresses default to the verified list in src/config.ts; override only if needed
# STOCK_TOKEN_NVDA=0x...
HARVEST_INTERVAL_MS=900000
# Long.xyz launcher, scanned for LaunchCreated to know which tickers are taken
LONG_LAUNCHER_ADDRESS=0x22e99278308B393ea1260859B181AD7E78f5eeED
LONG_START_BLOCK=8636038
TICKER_SYNC_INTERVAL_MS=60000
# Max base units paid per asset per claim transaction (0 = no cap)
MAX_PAYOUT_PER_CLAIM=0

# Optional: pin token metadata to IPFS
PINATA_JWT=

# Optional: override a market logo, e.g. LOGO_SPCX=https://example.com/spacex.png

# "Send fees" (`fees @user` in the launch tweet). On by default; set false to turn it off.
SEND_FEES_ENABLED=true

# Launch through Long.xyz's launcher so tokens are listed on app.long.xyz ("long", default) or straight on Doppler ("doppler").
LAUNCH_VIA=doppler
# A real app.long.xyz launch reused as the template for every launch (verified on-chain at startup).
LONG_TEMPLATE_TX=0xf2b83f462671397a3d8b77b65f42ec71e5b6fb2ceacbaff79a34fba6d36ca09d
# Pinata JWT (pinata.cloud, free): needed for the token image/links to show on app.long.xyz.
PINATA_JWT=

# X accounts with no launch limit / account minimums (e.g. your own): usernames or numeric IDs, comma-separated.
UNLIMITED_ACCOUNTS=nathanbullish

# Set to any new value (e.g. 1) to delete all launch history once on the next start; then remove it.
CLEAR_LAUNCH_HISTORY=
